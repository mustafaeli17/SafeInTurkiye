VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Local demo data is deliberately off by default. Set to true only for explicit demos.
VITE_ENABLE_MOCK_DATA=false

# Server-only Vercel variable. Never prefix this with VITE_ and never expose it in browser code.
GOOGLE_ROUTES_API_KEY=
# Public production browser key. Restrict it to the production hostnames and the
# Maps Embed API. Never reuse the unrestricted server key here.
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Optional separate Preview key, restricted to the exact Preview referrer + Maps Embed API.
# If absent, Preview uses the existing OSM route map; production keeps Google Maps.
VITE_GOOGLE_MAPS_PREVIEW_BROWSER_KEY=
# Transit server key: restrict to Routes API. Preview only until approval.
GOOGLE_TRANSIT_API_KEY=
# Separate public map key: restrict to Maps JavaScript API and exact Preview referrer.
VITE_GOOGLE_TRANSIT_MAP_KEY=
# Optional comma-separated allowed origins for local server tests.
TRANSIT_ALLOWED_ORIGINS=

# Restaurant intake stays OFF until migration 0006 + verified mail sender pass Preview QA.
VITE_RESTAURANT_REQUESTS=false
RESERVATIONS_ENABLED=false
# Server only: never use VITE_ for these secrets.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESERVATION_EMAIL_FROM=
CRON_SECRET=
# Local QA origins only; leave empty on deployed environments.
RESERVATION_ALLOWED_ORIGINS=
