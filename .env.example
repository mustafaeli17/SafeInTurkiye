VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Local demo data is deliberately off by default. Set to true only for explicit demos.
VITE_ENABLE_MOCK_DATA=false

# Server-only Vercel variable. Never prefix this with VITE_ and never expose it in browser code.
GOOGLE_ROUTES_API_KEY=
# Public browser key. Restrict it to the production/preview hostnames and the
# Maps Embed API. Never reuse the unrestricted server key here.
VITE_GOOGLE_MAPS_BROWSER_KEY=
